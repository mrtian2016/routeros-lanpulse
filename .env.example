# 复制为 .env。这里放密码, config.toml 里只放地址和名字 —— 这样配置文件可以直接贴出来问问题。
TZ=Asia/Shanghai
BIND_ADDR=0.0.0.0          # 想只让本机访问就改 127.0.0.1
LANPULSE_PORT=9132
RETENTION=30d

# RouterOS 只读账号 (建议单独建一个 group=read 的用户, 不要用 admin)
ROS_PASS=

# 设置页管理员密码。**不填则设置页整个关闭**, 不会有默认密码被人扫到。
ADMIN_PASSWORD=

# Proxmox VE API token
PVE_USER=
PVE_TOKEN_NAME=
PVE_TOKEN_VALUE=

# UniFi 控制器
UNIFI_URL=
UNIFI_API_KEY=

# NetFlow 收集器: 只统计这个网段内的流量, 用来过滤 NAT 后的重复流
LAN_CIDR=192.168.1.0/24

# ── 告警外发 ───────────────────────────────────────────────────────────────
# Bark: iOS 推送。device key 在 App 首页那串 URL 的最后一段。
BARK_KEY=

# Telegram: 找 @BotFather 建 bot 拿 token; chat id 可以给 bot 发条消息后访问
# https://api.telegram.org/bot<token>/getUpdates 查看。
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
