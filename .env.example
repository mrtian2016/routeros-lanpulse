# Copy to .env. Secrets live here; config.toml holds only addresses and names,
# so you can paste that file into an issue without redacting it first.
TZ=Asia/Shanghai
BIND_ADDR=0.0.0.0          # Set to 127.0.0.1 to expose the dashboard on localhost only
LANPULSE_PORT=9132
RETENTION=30d

# RouterOS read-only account. Create a dedicated user — do not use admin.
# See docs/SETUP.md step 1.
ROS_PASS=

# Settings-page admin password.
# LEAVE IT EMPTY AND THE SETTINGS PAGE IS DISABLED ENTIRELY — there is no default
# password to be scanned for. Set it only if you want to edit config from the browser.
ADMIN_PASSWORD=

# Proxmox VE API token
PVE_USER=
PVE_TOKEN_NAME=
PVE_TOKEN_VALUE=

# UniFi controller
UNIFI_URL=
UNIFI_API_KEY=

# NetFlow collector: only count traffic inside this subnet. Used to drop the
# duplicate flows that appear after NAT.
LAN_CIDR=192.168.1.0/24

# ── Alerting ───────────────────────────────────────────────────────────────
# Bark (iOS push). The device key is the last path segment of the URL the app shows.
BARK_KEY=

# Telegram: create a bot via @BotFather for the token; send it a message and read
# the chat id from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
